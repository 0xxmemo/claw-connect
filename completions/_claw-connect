#compdef claw-connect

_claw-connect() {
  local -a commands opts

  commands=(
    'setup:Interactive setup wizard'
    'profiles:List configured profiles'
    'sessions:List tracked session states'
    'clean-sessions:Remove stale session state files'
  )

  opts=(
    '-p[Use named profile]:profile:_claw_connect_profiles'
    '--profile[Use named profile]:profile:_claw_connect_profiles'
    '-t[Create SSH tunnel (gateway + VNC)]'
    '--tunnel[Create SSH tunnel (gateway + VNC)]'
    '-v[Direct VNC tunnel (raw protocol)]'
    '--vnc[Direct VNC tunnel (raw protocol)]'
    '-r[Resume tmux session (default)]'
    '--resume[Resume tmux session (default)]'
    '-s[Connect to specific session (create or join)]'
    '--session[Connect to specific session (create or join)]'
    '-l[List remote tmux sessions]'
    '--list[List remote tmux sessions]'
    '-k[Kill tmux session]:session:'
    '--kill[Kill tmux session]:session:'
    '-u[Override SSH user]:user:'
    '--user[Override SSH user]:user:'
    '--update[Update claw-connect to latest version]'
    '--init-tmux[Install tmux config on remote]'
    '--version[Print version]'
    '-h[Show help]'
    '--help[Show help]'
  )

  _arguments -s $opts

  if (( CURRENT == 2 )); then
    _describe 'command' commands
  fi
}

_claw_connect_profiles() {
  local config_dir="$HOME/.config/claw-connect/profiles"
  if [[ -d "$config_dir" ]]; then
    _files -W "$config_dir" -/
  fi
}

_claw-connect "$@"
